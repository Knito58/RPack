{
  "schemaVersion": 1,
  "id": "rpack",
  "version": "@VERSION@+@MC@",
  "name": "RPack",
  "description": "Recipes I am missing in vanilla: cheap wood slabs, stairs and sticks from logs, chainmail armor, elytra, spawner, ore recycling in furnaces, anvil repair and more.",
  "authors": ["Konitor"],
  "contact": {
    "sources": "https://github.com/Knito58/RPack",
    "issues": "https://github.com/Knito58/RPack/issues"
  },
  "license": "MIT",
  "icon": "assets/rpack/icon.png",
  "environment": "*",
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "~@MC@"
  }
}
